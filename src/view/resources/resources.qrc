<RCC>
  <qresource prefix="/styles">
    <file>qss/main_page.qss</file>
    <file>qss/dialog_box.qss</file>
    <file>qss/asset_page.qss</file>
    <file>qss/topbar.qss</file>
    <file>qss/page_widget.qss</file>
  </qresource>

  <qresource prefix="/background">
    <file>background/stocks_bg.png</file>
  </qresource>

 <qresource prefix="/icons">
    <file>icons/centicore_ic.png</file>
    <file>icons/add_ic.png</file>
    <file>icons/exit_btn_ic.png</file>
    <file>icons/minimize_btn_ic.png</file>
 </qresource>

 <qresource prefix="/config">
    <file>config/app.env</file>
    <file>config/app.conf</file>
 </qresource>
</RCC>
