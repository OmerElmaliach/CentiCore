/* --> General <-- */
QPushButton {
    color: white;
    border-radius: 8px;
    padding: 6px;
    font: bold 11pt 'Segoe UI';
}

/* --> Highlight current page <-- */
#stats_btn {
    background-color: #2b2b2b;
    border-left: 4px solid #3d3d3d;
}

/* --> Main Widget <-- */
#centralWidget {
    background-color: #1b1b1b;
}