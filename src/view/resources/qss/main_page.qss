/* --> General <-- */
QPushButton {
    color: white;
    border-radius: 8px;
    padding: 6px;
    font: bold 11pt 'Segoe UI';
}

/* --> Main Widget <-- */
#centralWidget {
    background-color: #252525;
}

/* --> Page Widget <-- */
#pageWidget {
    background-color: #333333;
    border-radius: 4px;
    border: 1px solid #414141;
}

#pageWidget QPushButton {
    background-color: #005186;
}

#pageWidget QPushButton:hover {
    background-color: #005b97;
}

#pageWidget QPushButton:pressed {
    background-color: #0063a5
}

/* --> Topbar <-- */
#topbarWidget {
    background-color: #4b4b4b;
    border-radius: 4px;
    border: 1px solid #555555;
}

#topbarWidget QLabel {
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    letter-spacing: 3px;
    font: bold 16pt 'Segoe UI';
}

#exit_btn,
#minimize_btn {
    background-color: #4b4b4b;
}

#exit_btn:hover {
    background-color: #a00000;
}

#minimize_btn:hover {
    background-color: #585858;
}

/* --> Statistic Widget <-- */
#gainedWidget,
#investWidget,
#networthWidget {
    border-radius: 4px;
    border: 1px solid #414141;
    background-image: url(:/background/background/stocks_bg.png);
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
}

#gainedText,
#investedText,
#networthText {
    font-size: 16px;
    color: white;
}

#gainedNum,
#investedNum,
#networthNum {
    color: #00be6f;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 20px;
    font-weight: bold;
}

/* --> Graph <-- */
#graphWidget {
    background-color: #1d1d1d;
    border-radius: 4px;
    border: 1px solid #292929;
}

/* --> Leading Stocks <-- */
#leadWidget {
    background-color: #1d1d1d;
    border-radius: 4px;
    border: 1px solid #292929;
}

/* --> Expenses List <-- */
#expensesLabel {
    font-size: 16px;
}

#expensesWidget {
    background-color: #2c2c2c;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    font-family: "Segoe UI";
    font-size: 16px;
    padding: 4px;
    outline: none;
}

#expensesWidget QLabel {
    color: white;
}

#expensesWidget QListView {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    padding: 8px;
    outline: none;
    margin: 4px;
}

#expensesWidget QListView::item {
    background-color: #242424;
    padding: 12px 16px;
    margin: 3px 2px;
    border-radius: 6px;
    border: 1px solid #2a2a2a;
    min-height: 20px;
}

#expensesWidget QListView::item:hover {
    background-color: #2a2a2a;
    border: 1px solid #5c0a0a;
}

#expensesWidget QListView::item:selected {
    background-color: #5c0a0a;
    border: 1px solid #6e0d0d;
    font-weight: bold;
}

#expensesWidget QListView::item:selected:hover {
    background-color: #6e0d0d;
    border: 1px solid #7f0f0f;
}

#expensesWidget #addExpense_btn:hover {
    background-color: #383838;
}

#expensesWidget #addExpense_btn:pressed {
    background-color: #414141;
}