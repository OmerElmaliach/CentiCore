/* --> General <-- */
QPushButton {
    color: white;
    border-radius: 8px;
    padding: 6px;
    font: bold 11pt 'Segoe UI';
}

/* --> Main Widget <-- */
#centralWidget {
    background-color: #252525;
}

/* --> Statistic Widget <-- */
#cashWidget,
#balanceWidget,
#networthWidget {
    border-radius: 4px;
    border: 1px solid #414141;
    background-image: url(:/background/background/stocks_bg.png);
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
    font-size: 20px;
    color: white;
}

#cashText,
#balanceText,
#networthText {
    color: #b0b0b0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

#cashNum,
#balanceNum,
#networthNum {
    color: white;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* --> Leading Stocks && Expense Graph <-- */
#leadWidget,
#graphWidget {
    background-color: #181818;
    border: 1px solid #464646;
}

/* --> Expenses List <-- */
#expensesLabel {
    font-size: 16px;
}

#expensesWidget {
    background-color: #2c2c2c;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    font-family: "Segoe UI";
    font-size: 16px;
    padding: 4px;
    outline: none;
}

#expensesWidget QLabel {
    color: white;
}

#expensesWidget QListView {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    padding: 8px;
    outline: none;
    margin: 4px;
}

#expensesWidget QListView::item {
    background-color: #242424;
    padding: 12px 16px;
    margin: 3px 2px;
    border-radius: 6px;
    border: 1px solid #2a2a2a;
    min-height: 20px;
}

#expensesWidget QListView::item:hover {
    background-color: #2a2a2a;
    border: 1px solid #5c0a0a;
}

#expensesWidget QListView::item:selected {
    background-color: #5c0a0a;
    border: 1px solid #6e0d0d;
    font-weight: bold;
}

#expensesWidget QListView::item:selected:hover {
    background-color: #6e0d0d;
    border: 1px solid #7f0f0f;
}

#expensesWidget #addExpense_btn:hover {
    background-color: #383838;
}

#expensesWidget #addExpense_btn:pressed {
    background-color: #414141;
}