/* --> General <-- */
QPushButton {
    color: white;
    border-radius: 8px;
    padding: 6px;
    font: bold 11pt 'Segoe UI';
}

QLabel {
    color: white;
}

/* --> Main Widget <-- */
#centralWidget {
    background-color: #252525;
}

/* --> Page Widget <-- */
#pageWidget {
    background-color: #333333;
    border-radius: 4px;
    border: 1px solid #414141;
}

#pageWidget QPushButton {
    background-color: #005186;
}

#pageWidget QPushButton:hover {
    background-color: #005b97;
}

#pageWidget QPushButton:pressed {
    background-color: #0063a5
}

/* --> Topbar <-- */
#topbarWidget {
    background-color: #4b4b4b;
    border-radius: 4px;
    border: 1px solid #555555;
}

#topbarWidget QLabel {
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    letter-spacing: 3px;
    font: bold 16pt 'Segoe UI';
}

#exit_btn,
#minimize_btn {
    background-color: #4b4b4b;
}

#exit_btn:hover {
    background-color: #a00000;
}

#minimize_btn:hover {
    background-color: #585858;
}

/* --> Investments List <-- */
#investsLabel {
    font-size: 16px;
}

#investsWidget {
    background-color: #2c2c2c;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    font-family: "Segoe UI";
    font-size: 16px;
    padding: 4px;
    outline: none;
}

#investsWidget QLabel {
    color: white;
}

#investsWidget QListView {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    padding: 8px;
    outline: none;
    margin: 4px;
}

#investsWidget QListView::item {
    background-color: #242424;
    padding: 12px 16px;
    margin: 3px 2px;
    border-radius: 6px;
    border: 1px solid #2a2a2a;
    min-height: 20px;
}

#investsWidget QListView::item:hover {
    background-color: #292929;
    border: 1px solid #255d25;
}

#investsWidget QListView::item:selected {
    background-color: #255d25;
    border: 1px solid #2f6b2f;
    font-weight: bold;
}

#investsWidget QListView::item:selected:hover {
    background-color: #2f6b2f;
    border: 1px solid #397939;
}

#investsWidget #addInvest_btn:hover {
    background-color: #383838;
}

#investsWidget #addInvest_btn:pressed {
    background-color: #414141;
}

/* --> Statistic Widget <-- */
#valueWidget,
#balanceWidget,
#changeWidget {
    border-radius: 4px;
    border: 1px solid #414141;
    background-image: url(:/background/background/stocks_bg.png);
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
    font-size: 20px;
    color: white;
}

#valueText,
#balanceText,
#changeText {
    color: #b0b0b0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

#valueNum,
#balanceNum,
#changeNum {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* --> Asset Tables <-- */
QTableView {
    border: 1px solid #414141;
    background-color: #1e1e1e;
    color: #e0e0e0;
    gridline-color: #2a2a2a;
    font-family: 'Segoe UI';
    font-size: 11pt;
    outline: none;
}

QTableView::item {
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #2a2a2a;
}

QTableView::item:hover {
    background-color: #2a2a2a;
}

QTableView::item:selected {
    background-color: #005186;
    color: white;
}

QTableView::item:selected:hover {
    background-color: #005b97;
}

/* Row and columns background */
QAbstractItemView {
    background-color: #1e1e1e;
}

/* Header styling */
QHeaderView::section {
    background-color: #333333;
    color: #ffffff;
    padding: 10px 12px;
    border: none;
    border-right: 1px solid #414141;
    border-bottom: 1px solid #414141;
    font-weight: bold;
    font-size: 11pt;
    text-align: left;
}

QHeaderView::section:hover {
    background-color: #3a3a3a;
}

QHeaderView::section:pressed {
    background-color: #005186;
}

/* Scrollbars for tables */
QTableView QScrollBar:vertical {
    background-color: #2c2c2c;
    width: 12px;
    border-radius: 6px;
    border: 1px solid #414141;
}

QTableView QScrollBar::handle:vertical {
    background-color: #005186;
    border-radius: 5px;
    min-height: 20px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #005b97;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

QTableView QScrollBar:horizontal {
    background-color: #2c2c2c;
    height: 12px;
    border-radius: 6px;
    border: 1px solid #414141;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #005186;
    border-radius: 5px;
    min-width: 20px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #005b97;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
}

/* Container widgets */
#stocksWidget,
#cryptoWidget {
    border: 1px solid #414141;
    background-color: #552020;
    border-radius: 8px;
    padding: 4px;
}

#stocksTxt,
#cryptoTxt {
    font-size: 16px;
    letter-spacing: 1px;
}

#stocksWidget QPushButton:hover,
#cryptoWidget QPushButton:hover {
    background-color: #642525;
}

#stocksWidget QPushButton:pressed,
#cryptoWidget QPushButton:pressed {
    background-color: #6d2929;
}