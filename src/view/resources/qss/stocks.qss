/* --> General <-- */
QPushButton {
    color: white;
    border-radius: 8px;
    padding: 6px;
    font: bold 11pt 'Segoe UI';
}

QLabel {
    color: white;
}

/* --> Main Widget <-- */
#centralWidget {
    background-color: #252525;
}

/* --> Page Widget <-- */
#pageWidget {
    background-color: #333333;
    border-radius: 4px;
    border: 1px solid #414141;
}

#pageWidget QPushButton {
    background-color: #005186;
}

#pageWidget QPushButton:hover {
    background-color: #005b97;
}

#pageWidget QPushButton:pressed {
    background-color: #0063a5
}

/* --> Topbar <-- */
#topbarWidget {
    background-color: #4b4b4b;
    border-radius: 4px;
    border: 1px solid #555555;
}

#topbarWidget QLabel {
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    letter-spacing: 3px;
    font: bold 16pt 'Segoe UI';
}

#exit_btn,
#minimize_btn {
    background-color: #4b4b4b;
}

#exit_btn:hover {
    background-color: #a00000;
}

#minimize_btn:hover {
    background-color: #585858;
}

/* --> Investments List <-- */
#investsLabel {
    font-size: 16px;
}

#investsWidget {
    background-color: #2c2c2c;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    font-family: "Segoe UI";
    font-size: 16px;
    padding: 4px;
    outline: none;
}

#investsWidget QLabel {
    color: white;
}

#investsWidget QListView {
    background-color: #1e1e1e;
    color: #bb0000;
    border: 1px solid #3d3d3d;
    font-size: 16px;
    padding: 4px;
    outline: none;
}

#investsWidget QListView::item {
    background-color: transparent;
    padding: 8px 12px;
    margin: 2px;
    border-radius: 6px;
}

#investsWidget QListView::item:hover {
    background-color: #242424;
}

#investsWidget QListView::item:selected {
    background-color: #2c2c2c;
    color: #bb0000;
    font-weight: bold;
}

#investsWidget #addInvest_btn:hover {
    background-color: #383838;
}

#investsWidget #addInvest_btn:pressed {
    background-color: #414141;
}

/* --> Statistic Widget <-- */
#valueWidget,
#investedWidget,
#changeWidget {
    border-radius: 4px;
    border: 1px solid #414141;
    background-image: url(:/background/background/stocks_bg.png);
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
}

#valueWidget,
#investedWidget,
#changeWidget {
    font-size: 16px;
    color: white;
}

#valueWidget,
#investedWidget,
#changeWidget {
    color: #00be6f;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 20px;
    font-weight: bold;
}

/* --> Asset Tables <-- */
QTableView {
    border: 1px solid #3a3a3a;
    border-top: 1px solid #424242;
    border-radius: 0 0 8px 8px;
    background-color: #1b1b1b;
    color: #e0e0e0;
}

QHeaderView::section {
    background-color: #3a3a3a;
    color: #f0f0f0;
    padding: 6px;
    border: 1px solid #444;
    font-weight: bold;
    border-radius: 4px;
}

QTableCornerButton::section {
    background-color: #3a3a3a;
    border: 1px solid #444;
    border-radius: 4px;
}

#stocksWidget,
#cryptoWidget {
    border: 1px solid #424242;
    background-color: #222222;
    border-radius: 8px;
}

#stocksTxt,
#cryptoTxt {
    font-size: 16px;
    letter-spacing: 1px;
}